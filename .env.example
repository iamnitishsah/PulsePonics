# PulsePonics stack configuration for docker compose.
#   cp .env.example .env    then replace every "change-me" value.
# Generate secrets with:  openssl rand -hex 32
# .env is gitignored. Never commit it.

# ---------- MySQL ----------
DB_NAME=pulseponics
DB_USER=pulse
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
# Host port for MySQL tools (bound to 127.0.0.1 only). 3307 avoids a local MySQL on 3306.
MYSQL_HOST_PORT=3307

# ---------- MQTT (Mosquitto) ----------
# Backend account: subscribes to hydroponics/#
MQTT_BACKEND_USERNAME=pulse-backend
MQTT_BACKEND_PASSWORD=change-me
# Device account, shared by every ESP32: goes into pulse-hardware/include/secrets.h
# as MQTT_USER / MQTT_PASSWORD.
MQTT_DEVICE_USERNAME=pulse-device
MQTT_DEVICE_PASSWORD=change-me
MQTT_HOST_PORT=1883

# ---------- Backend ----------
# At least 32 characters. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
BACKEND_HOST_PORT=8080
# Browser origins allowed to call the API (comma-separated, "*" wildcards allowed).
# Local Vite dev server, plus your Vercel URL(s) in production, e.g.:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,https://pulseponics.vercel.app,https://pulseponics-*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
# true on EC2 (requests arrive through Caddy), false locally.
TRUST_PROXY_HEADERS=false
# Optional: a prebuilt image (e.g. ghcr.io/<you>/pulseponics-backend:latest) instead of building locally.
# BACKEND_IMAGE=

# ---------- HTTPS (EC2 only, docker compose --profile prod) ----------
# Your Elastic IP with dots replaced by dashes + .sslip.io, e.g. 13.233.10.20 -> 13-233-10-20.sslip.io
API_DOMAIN=

# ---------- Simulator (docker compose --profile sim) ----------
# Register this device ID in the dashboard first, or its telemetry is dropped.
SIM_DEVICE_ID=esp32-sim-01
SIM_INTERVAL=10s
